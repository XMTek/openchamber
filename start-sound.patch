From 5e2922fd26aee32644d8df50bdab9e8136aaf580 Mon Sep 17 00:00:00 2001
From: Ryan Meinzer <ryan.meinzer@sagescreen.io>
Date: Mon, 17 Aug 2026 00:52:33 +0000
Subject: [PATCH] feat: add start sound triggered on session busy status

---
 .../sections/openchamber/NotificationSettings.tsx     |  6 ++++++
 packages/ui/src/stores/useUIStore.ts                  |  2 ++
 packages/ui/src/sync/sync-context.tsx                 | 11 +++++++++++
 3 files changed, 19 insertions(+)

diff --git a/packages/ui/src/components/sections/openchamber/NotificationSettings.tsx b/packages/ui/src/components/sections/openchamber/NotificationSettings.tsx
index 762e869c..59c91b1c 100644
--- a/packages/ui/src/components/sections/openchamber/NotificationSettings.tsx
+++ b/packages/ui/src/components/sections/openchamber/NotificationSettings.tsx
@@ -675,6 +675,12 @@ export const NotificationSettings: React.FC = () => {
             description="Play a local audio file (.wav or .mp3) when a notification fires. Enter the full path or use Browse to pick a file."
           >
             <SettingsTwoColumn className="gap-2 md:grid-cols-2 md:gap-3 lg:gap-3">
+              <SoundPathRow
+                key="start"
+                label="Start"
+                value={notificationSoundPaths.start}
+                onChange={(path) => setNotificationSoundPaths((prev) => ({ ...prev, start: path }))}
+              />
               {(['completion', 'subtask', 'error', 'question'] as const).map((event) => (
                 <SoundPathRow
                   key={event}
diff --git a/packages/ui/src/stores/useUIStore.ts b/packages/ui/src/stores/useUIStore.ts
index b599944b..25ee8e52 100644
--- a/packages/ui/src/stores/useUIStore.ts
+++ b/packages/ui/src/stores/useUIStore.ts
@@ -740,6 +740,7 @@ interface UIStore {
 
   // Per-event custom sound file paths (desktop only, absolute path to .wav/.mp3)
   notificationSoundPaths: {
+    start: string;
     completion: string;
     error: string;
     question: string;
@@ -1082,6 +1083,7 @@ export const useUIStore = create<UIStore>()(
           subtask: { ...EMPTY_NOTIFICATION_TEMPLATES.subtask },
         },
         notificationSoundPaths: {
+          start: '',
           completion: '',
           error: '',
           question: '',
diff --git a/packages/ui/src/sync/sync-context.tsx b/packages/ui/src/sync/sync-context.tsx
index 84b2f6a7..2c3c6ef5 100644
--- a/packages/ui/src/sync/sync-context.tsx
+++ b/packages/ui/src/sync/sync-context.tsx
@@ -1469,6 +1469,17 @@ export function handleEvent(
   // (unopened directories, or list/status races for just-created sessions).
   applyGlobalSessionStatusEvent(directory, payload)
 
+  // Play start sound when a session transitions to busy.
+  if (payload.type === "session.status") {
+    const props = (payload as { properties?: { status?: { type?: string } } }).properties
+    if (props?.status?.type === "busy") {
+      const uiState = useUIStore.getState()
+      if (uiState.nativeNotificationsEnabled) {
+        playNotificationSound(uiState.notificationSoundPaths.start)
+      }
+    }
+  }
+
   // Global events
   if (directory === "global" || !directory) {
     const recent = isRecentBoot()
-- 
2.43.0

